#!/bin/bash
# Fake blkid. Fixture comes from $ZLT_BLKID (one blkid output line per line).
# Supports: bare `blkid`, `blkid -U <uuid>`, `blkid -o value -s <TAG> <dev>`.
set -u
lines(){ printf '%s\n' "$ZLT_BLKID"; }

if [ "${1:-}" = "-U" ]; then                       # UUID -> device
  # like /dev/disk/by-uuid: an mdadm member shares the array's UUID but is never the target
  dev="$(lines | grep -F " UUID=\"$2\"" | grep -v 'TYPE="linux_raid_member"' | head -1 | cut -d: -f1)"
  [ -n "$dev" ] || exit 2
  echo "$dev"; exit 0
fi

if [ "${1:-}" = "-o" ]; then                       # -o value -s <TAG> <dev>
  tag="$4"; dev="${*: -1}"
  v="$(lines | grep -F "$dev:" | head -1 | grep -oE " $tag=\"[^\"]+\"" | cut -d'"' -f2)"
  [ -n "$v" ] || exit 2
  echo "$v"; exit 0
fi

lines
