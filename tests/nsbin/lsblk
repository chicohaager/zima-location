#!/bin/bash
# lsblk -rno FSTYPE,UUID for the namespace world. A disk with $ZLT_STATE/raid-<uuid> is an
# mdadm array: like on ZimaOS (second test NAS) its members carry the same UUID and are listed FIRST.
set -u
S="${ZLT_STATE:?}"
for f in "$S"/disk-*; do
  [ -e "$f" ] || continue; u="${f##*/disk-}"
  [ -e "$S/raid-$u" ] && { echo "linux_raid_member $u"; echo "linux_raid_member $u"; }
  echo "$(cat "$f") $u"
done
